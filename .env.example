# Copy to .env.local. Never commit real credentials.
#
# NEXT_PUBLIC_* values are bundled into browser code: they are public by design.
# Never put a secret behind a NEXT_PUBLIC_ prefix.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security, so it is read exclusively by the
# offline demo seed script and must never reach a Client Component or a request.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Session pooler connection string used by the npm scripts that
# target the hosted project (supabase:push, supabase:types, supabase:test), so
# the workflow does not need Docker. Host is aws-0-<region>.pooler.supabase.com
# and the username is postgres.<project-ref>. Copy it from Project Settings ->
# Database -> Connection string (URI).
SUPABASE_DB_URL=
