# Environment
.env
.env.local
.env.production
.env.*.local

# Dependencies
node_modules/

# Build outputs
.next/
out/
src/generated/prisma/
*.tsbuildinfo

# Rewritten by every `next dev`, `next build`, and `next typegen`. Next.js
# documents this as an implementation detail: never commit or edit it.
next-env.d.ts

# IDE
.idea/
.vscode/
*.iml
*.suo
*.user

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
npm-debug.log*

# Testing
coverage/
playwright-report/
test-results/

# Docker volumes
postgres-data/

# Supabase
.supabase/
supabase/.temp/

# Vercel
# `vercel link` writes .vercel/project.json, which holds the project and org id.
# It is per-developer local state, and Vercel's own docs say to ignore it.
.vercel
